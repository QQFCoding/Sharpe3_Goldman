# Publicly documented tokens are for the loopback-only demo.
AICL_DEMO_MODE=true
AICL_OPA_URL=http://127.0.0.1:8181
AICL_LLM_URL=http://127.0.0.1:8081
AICL_MCP_URL=http://127.0.0.1:8082
# Production MCP/tool outputs default to untrusted. Safe demo mocks default to trusted.
# AICL_MCP_OUTPUT_TRUST=untrusted
AICL_ADMIN_TOKEN=demo-admin-token
# For deployment: set DEMO_MODE=false and AUTH_FILE to a JSON list of
# {token_sha256, principal: {subject, tenant_id, roles, scopes, agent_id}}.
# AICL_AUTH_FILE=./auth.json
# AICL_REDIS_URL=redis://127.0.0.1:6379/0
# AICL_DATABASE_URL=postgresql://aicl:change-me@127.0.0.1:5432/aicl
# No classifier weights are downloaded during startup.
AICL_SEMANTIC_PROVIDER=none
# AICL_SEMANTIC_PROVIDER=prompt_guard
# Public evaluated alternative:
# AICL_SEMANTIC_PROVIDER=deberta
# AICL_DEBERTA_PATH=./models/deberta
# AICL_ALIGNMENT_PROVIDER=ollama
# AICL_JWT_JWKS_PATH=./config/demo-jwks.json
# AICL_PROMPT_GUARD_PATH=./models/prompt-guard
# AICL_SEMANTIC_PROVIDER=ollama
# AICL_OLLAMA_URL=http://127.0.0.1:11434
# AICL_OLLAMA_MODEL=qwen3:4b
# AICL_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
